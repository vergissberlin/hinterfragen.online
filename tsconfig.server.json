{
  "extends": "./tsconfig.json",
  "include": ["server/**/*.ts", "scripts/**/*.ts", "src/lib/**/*.ts", "tests/**/*.ts"],
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "astro/client", "webmcp-types"]
  }
}
