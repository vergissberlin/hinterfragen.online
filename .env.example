# Copy to .env; never commit real values. Compose reads this file automatically.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgres://portal:replace-with-a-long-random-database-password@localhost:5432/portal
ADMIN_TOKEN=replace-with-a-distinct-random-admin-token-at-least-32-characters
AGENT_TOKEN=replace-with-a-distinct-random-agent-token-at-least-32-characters
PUBLIC_ORIGIN=http://localhost:8080
HOST=127.0.0.1
PORT=3001
DATA_DIR=.runtime/data
YOUTUBE_API_KEY=
AUTO_PUBLISH=false
MODEL_SHA256=6c1a2b41161032677be168d354123594c0e6e67d2b9227c84f296ad037c728ff
# Compute with: npx tsx scripts/prompt-digest.ts
PROMPT_SHA256=
CALIBRATION_PATH=config/calibration.json
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=
LIVE_MODE=false
PUBLIC_DEMO_MODE=false
PUBLIC_OPERATOR_NAME=
PUBLIC_OPERATOR_ADDRESS=
PUBLIC_OPERATOR_EMAIL=
# Optional commenting authorization, NOT portal login. Public client ID, no client secret.
PUBLIC_YOUTUBE_CLIENT_ID=
